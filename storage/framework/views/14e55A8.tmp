        <div class="supplier">
            Kepada Yth.
            <strong><?php echo e($order->supplier_name); ?></strong>
            <?php if($order->supplier_address): ?><?php echo e($order->supplier_address); ?><br><?php endif; ?>
            <?php if($order->supplier_phone): ?>Nomor telepon: <?php echo e($order->supplier_phone); ?><?php endif; ?>
        </div>
        <p>Mohon disiapkan barang berikut untuk <?php echo e($identity['name']); ?>:</p>
        <table>
            <thead>
                <?php if($type === 'precursor'): ?>
                    <tr><th style="width:5%">No.</th><th>Nama Obat</th><th>Zat Aktif Prekursor</th><th>Bentuk / Kekuatan</th><th>Jumlah</th><th class="number">Harga Modal</th><th class="number">Ajuan Potongan</th><th class="number">Subtotal</th></tr>
                <?php elseif($type === 'oot'): ?>
                    <tr><th style="width:5%">No.</th><th>Nama Obat</th><th>Zat Aktif OOT</th><th>Bentuk / Kekuatan</th><th>Jumlah</th><th class="number">Harga Modal</th><th class="number">Ajuan Potongan</th><th class="number">Subtotal</th></tr>
                <?php else: ?>
                    <tr><th style="width:5%">No.</th><th>Nama Produk</th><th>Bentuk / Kekuatan</th><th>Kode Supplier</th><th>Satuan</th><th>Jumlah</th><th class="number">Harga Modal</th><th class="number">Ajuan Potongan</th><th class="number">Subtotal</th></tr>
                <?php endif; ?>
            </thead>
            <tbody>
            <?php $__currentLoopData = $order->items; $__env->addLoop($__currentLoopData); foreach($__currentLoopData as $index => $item): $__env->incrementLoopIndices(); $loop = $__env->getLastLoop(); ?>
                <tr>
                    <td><?php echo e($index + 1); ?></td>
                    <td>
                        <?php echo e($item->product_name); ?>

                        <?php if($item->supplier_code): ?><br><small>Kode supplier: <?php echo e($item->supplier_code); ?></small><?php endif; ?>
