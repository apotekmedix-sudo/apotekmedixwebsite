                        <td><?php echo e($type === 'precursor' ? number_format($item->quantity, 0, ',', '.') . ' (' . ucfirst($spellNumber((int) $item->quantity)) . ')' : number_format($item->quantity, 0, ',', '.')); ?> <?php echo e($item->unit_label); ?></td>
                        <td class="number">Rp <?php echo e(number_format((float) $item->unit_cost, 0, ',', '.')); ?></td>
                        <td class="number"><?php echo e((float) $item->requested_discount > 0 ? 'Rp ' . number_format((float) $item->requested_discount, 0, ',', '.') : '—'); ?></td>
                        <td class="number">Rp <?php echo e(number_format((float) $item->line_total, 0, ',', '.')); ?></td>
                    <?php else: ?>
                        <td><?php echo e(collect([$item->dosage_form, $item->strength])->filter()->implode(' / ') ?: '—'); ?></td>
                        <td><?php echo e($item->supplier_code ?: '—'); ?></td>
                        <td><?php echo e($item->unit_label); ?></td>
                        <td><?php echo e(number_format($item->quantity, 0, ',', '.')); ?></td>
                        <td class="number">Rp <?php echo e(number_format((float) $item->unit_cost, 0, ',', '.')); ?></td>
                        <td class="number"><?php echo e((float) $item->requested_discount > 0 ? 'Rp ' . number_format((float) $item->requested_discount, 0, ',', '.') : '—'); ?></td>
                        <td class="number">Rp <?php echo e(number_format((float) $item->line_total, 0, ',', '.')); ?></td>
                    <?php endif; ?>
                </tr>
            <?php endforeach; $__env->popLoop(); $loop = $__env->getLastLoop(); ?>
            </tbody>
            <tfoot><tr><td colspan="<?php echo e(in_array($type, ['oot', 'precursor'], true) ? 6 : 7); ?>" class="number">Total pesanan</td><td class="number">Rp <?php echo e(number_format((float) $order->items->sum(fn ($item) => (float) $item->requested_discount), 0, ',', '.')); ?></td><td class="number">Rp <?php echo e(number_format((float) $order->items->sum(fn ($item) => (float) $item->line_total), 0, ',', '.')); ?></td></tr></tfoot>
