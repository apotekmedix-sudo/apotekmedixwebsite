        tfoot td { font-weight:800; background:#f8fafc; }
        .notes { margin-top:18px; color:#475569; line-height:1.6; white-space:pre-line; }
        .signature { width:250px; margin:55px 0 0 auto; text-align:center; line-height:1.8; }
        .signature-space { height:75px; }
        .signature-space { position:relative; }
        .signature-stamp { position:absolute; top:50%; width:150px; height:100px; object-fit:contain; mix-blend-mode:multiply; transform:translate(-50%,-50%); }
        .signature-stamp-pharmacist { left:30%; z-index:1; }
        .signature-stamp-pharmacy { left:70%; z-index:1; }
        @media print {
            body { padding:0; background:#fff; }
            .toolbar { display:none; }
            .document { width:100%; min-height:0; padding:0; border:0; box-shadow:none; }
            @page { size:A4; margin:14mm; }
        }
        @media(max-width:600px) {
            body { padding:10px; }
            .document { min-height:0; padding:20px 14px; }
            th,td { padding:6px 4px; font-size:11px; }
        }
    </style>
</head>
